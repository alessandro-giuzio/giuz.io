---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site, personId, websiteId } from '@/site.config';
import { knowsAbout } from '@/data/landing';

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Set true for pages that must not be indexed (e.g. 404, drafts). */
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  /** Extra schema.org nodes for this page, merged into the site graph. */
  schema?: Record<string, unknown>[];
}

const { title, description = site.description, noindex = false, ogType = 'website', schema = [] } = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.jobTitle}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
// Indexable pages allow full snippets and large image previews (search and AI answers).
const robots = noindex ? 'noindex, follow' : 'max-snippet:-1, max-image-preview:large, max-video-preview:-1';

const nodes: Record<string, unknown>[] = [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      url: `${site.url}/`,
      jobTitle: site.jobTitle,
      email: `mailto:${site.email}`,
      image: new URL(site.photo, site.url).href,
      knowsLanguage: site.languages,
      knowsAbout,
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.location.city,
        addressRegion: site.location.region,
        addressCountry: site.location.country,
      },
      sameAs: site.sameAs,
      worksFor: {
        '@type': 'Organization',
        '@id': site.studio.id,
        name: site.studio.name,
        url: site.studio.url,
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: site.lang,
      publisher: { '@id': personId },
      license: site.license,
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: site.lang,
      isPartOf: { '@id': websiteId },
      about: { '@id': personId },
    },
];

// Page nodes that reuse an @id from above (e.g. the Person) add properties to that node instead of duplicating it.
for (const node of schema) {
  const existing = nodes.find((n) => n['@id'] && n['@id'] === node['@id']);
  if (existing) Object.assign(existing, node);
  else nodes.push(node);
}
const graph = { '@context': 'https://schema.org', '@graph': nodes };
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Apply the saved light/dark choice before first paint, so there's no flash. See ThemeToggle.astro. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- Google: no canonical on noindex pages. -->
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />

    <!-- Self-hosted fonts. Preload only what the first screen needs: body text and headings. -->
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-instrument" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-plex-mono" />

    <!-- Icons: ICO for old browsers and tools, SVG (with dark variant) for modern ones, PNG for iOS. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5f6eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a110d" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.ogImage.src, site.url).href} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-(--container-page) flex-1 px-5 py-12 sm:px-8 sm:py-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>

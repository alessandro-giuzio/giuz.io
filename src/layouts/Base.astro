---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site, personId, websiteId } from '@/site.config';

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Set true for pages that must not be indexed (e.g. 404, drafts). */
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  /** Extra schema.org nodes for this page, merged into the site graph. */
  schema?: Record<string, unknown>[];
}

const { title, description = site.description, noindex = false, ogType = 'website', schema = [] } = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.jobTitle}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      url: `${site.url}/`,
      jobTitle: site.jobTitle,
      email: `mailto:${site.email}`,
      knowsLanguage: site.languages,
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.location.city,
        addressRegion: site.location.region,
        addressCountry: site.location.country,
      },
      sameAs: site.sameAs,
      worksFor: {
        '@type': 'Organization',
        name: site.studio.name,
        url: site.studio.url,
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: site.lang,
      publisher: { '@id': personId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: site.lang,
      isPartOf: { '@id': websiteId },
      about: { '@id': personId },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Self-hosted fonts. Preload only what the first screen needs: body text and headings. -->
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-instrument" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-plex-mono" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f9f8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171c" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- TODO: add og:image (1200×630) once the visual direction exists. -->
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-(--container-page) flex-1 px-5 py-12 sm:px-8 sm:py-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
/**
 * Light/dark switch. The page follows the system setting until the visitor clicks;
 * then their choice is saved in localStorage and applied before first paint
 * (see the inline script in Base.astro). Colours flip through light-dark() in global.css.
 */
---

<button
  type="button"
  class="theme-toggle inline-flex size-9 items-center justify-center rounded-md border border-line text-muted hover:border-fg hover:text-fg"
  aria-label="Cambiar entre modo claro y oscuro"
  title="Cambiar entre modo claro y oscuro"
  data-theme-toggle
>
  <!-- Moon: shown in light mode -->
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
  </svg>
  <!-- Sun: shown in dark mode -->
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const dark = window.matchMedia('(prefers-color-scheme: dark)');
  // Browser UI colour (phone status bar) for each theme. Matches --bg in global.css.
  const themeColor = { light: '#f5f6eb', dark: '#0a110d' };

  const current = () => root.dataset.theme ?? (dark.matches ? 'dark' : 'light');

  const syncThemeColor = () => {
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
      if (root.dataset.theme) meta.setAttribute('content', themeColor[root.dataset.theme as 'light' | 'dark']);
    });
  };

  syncThemeColor();

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Private mode or storage blocked: the switch still works for this page view.
      }
      syncThemeColor();
    });
  });
</script>

---
import { nav, site } from '@/site.config';
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-(--container-page) flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-5 sm:px-8">
    <a href="/" class="font-mono text-step-0 font-semibold tracking-tight no-underline" aria-label={`${site.name}, inicio`}>
      giuz<span class="text-accent">.io</span>
    </a>
    <nav aria-label="Principal">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-step--1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-muted no-underline hover:text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

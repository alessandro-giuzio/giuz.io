---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { personId } from '@/site.config';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos', ({ data }) => !data.draft);
  return proyectos.map((proyecto) => ({ params: { id: proyecto.id }, props: { proyecto } }));
}

const { proyecto } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);

const schema = [
  {
    '@type': 'CreativeWork',
    name: data.title,
    description: data.description,
    dateCreated: String(data.year),
    creator: { '@id': personId },
    ...(data.url ? { url: data.url } : {}),
  },
];
---

<Base title={data.title} description={data.description} ogType="article" schema={schema}>
  <article class="space-y-10">
    <header class="max-w-(--container-prose) space-y-4">
      <p class="font-mono text-step--1 text-muted">{data.client} · {data.year}</p>
      <h1 class="text-heading-1">{data.title}</h1>
      <p class="text-step-1 text-muted">{data.description}</p>
      {data.stack.length > 0 && <p class="font-mono text-step--1 text-muted">{data.stack.join(' · ')}</p>}
      {
        data.url && (
          <p>
            <a href={data.url} class="text-accent underline">
              Ver el sitio
            </a>
          </p>
        )
      }
    </header>

    {
      data.results.length > 0 && (
        <dl class="grid max-w-(--container-prose) gap-4 sm:grid-cols-3">
          {data.results.map((r) => (
            <div class="rounded-lg border border-line p-4">
              <dt class="text-step--1 text-muted">{r.label}</dt>
              <dd class="mt-1 font-mono text-step-2">{r.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <p><a href="/proyectos/" class="text-accent underline">← Todos los proyectos</a></p>
  </article>
</Base>

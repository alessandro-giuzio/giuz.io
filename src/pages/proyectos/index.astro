---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Pending from '@/components/Pending.astro';

const proyectos = (await getCollection('proyectos', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<Base title="Proyectos" description="Casos técnicos: qué problema había, qué construí y qué cambió en números.">
  <div class="space-y-10">
    <header class="max-w-(--container-prose) space-y-4">
      <h1 class="text-step-4">Proyectos</h1>
      <p class="text-step-1 text-muted">El problema, lo que construí y los números antes y después.</p>
    </header>

    {
      proyectos.length === 0 ? (
        <Pending what="los primeros casos. Pon draft: false en src/content/proyectos/*.md para publicarlos." />
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2">
          {proyectos.map((p) => (
            <li class="rounded-lg border border-line p-6">
              <p class="font-mono text-step--1 text-muted">
                {p.data.client} · {p.data.year}
              </p>
              <h2 class="mt-2 text-step-2">
                <a href={`/proyectos/${p.id}/`} class="no-underline hover:underline">
                  {p.data.title}
                </a>
              </h2>
              <p class="mt-2 text-muted">{p.data.description}</p>
              {p.data.stack.length > 0 && (
                <p class="mt-4 font-mono text-step--1 text-muted">{p.data.stack.join(' · ')}</p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

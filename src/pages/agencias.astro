---
import Base from '@/layouts/Base.astro';
import Pending from '@/components/Pending.astro';
---

<Base
  title="Para agencias"
  description="Desarrollo white-label, revisiones técnicas y bonos de sesiones para agencias y estudios que necesitan un desarrollador front-end de confianza."
>
  <div class="max-w-(--container-prose) space-y-12">
    <header class="space-y-4">
      <h1 class="text-step-4">Para agencias y estudios</h1>
      <p class="text-step-1 text-muted">El desarrollador detrás de vuestros diseños.</p>
    </header>

    <section class="space-y-4" aria-labelledby="revision">
      <h2 id="revision" class="text-step-2">Revisión técnica</h2>
      <Pending what="auditoría de rendimiento, accesibilidad (WCAG AA), SEO técnico y estructura. Precio fijo." />
    </section>

    <section class="space-y-4" aria-labelledby="white-label">
      <h2 id="white-label" class="text-step-2">Desarrollo white-label</h2>
      <Pending what="construcción en Astro, WordPress o Vue con vuestro nombre. NDA, proceso y entregables." />
    </section>

    <section class="space-y-4" aria-labelledby="sesiones">
      <h2 id="sesiones" class="text-step-2">Bono de sesiones</h2>
      <Pending what="paquete de sesiones flexibles para consultoría, correcciones o desarrollo." />
    </section>

    <section class="space-y-4" aria-labelledby="proceso">
      <h2 id="proceso" class="text-step-2">Cómo empezamos</h2>
      <Pending what="los pasos: llamada de 20 minutos, revisión técnica, colaboración." />
    </section>
  </div>
</Base>

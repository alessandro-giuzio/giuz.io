---
/**
 * Colour specimen: three palettes, each in light and dark, with real copy.
 * Temporary page on the design/colors branch. noindex, not in the sitemap.
 * Contrast ratios (WCAG 2.x) were computed from these exact OKLCH values.
 */
import Base from '@/layouts/Base.astro';

type Mode = { bg: string; surface: string; fg: string; muted: string; line: string; accent: string; accentFg: string; mark: string };
type Palette = {
  id: string;
  name: string;
  note: string;
  light: Mode;
  dark: Mode;
  hex: { light: Record<keyof Mode, string>; dark: Record<keyof Mode, string> };
  contrast: { light: string; dark: string };
};

const palettes: Palette[] = [
  {
    id: 'tinta',
    name: '1 · Papel y tinta',
    note: 'La referencia: papel cálido y tinta azul profunda. Sobrio y atemporal, el color casi no se nota.',
    light: { bg: 'oklch(97.5% 0.012 85)', surface: 'oklch(94.5% 0.014 85)', fg: 'oklch(21% 0.02 265)', muted: 'oklch(47% 0.02 265)', line: 'oklch(87% 0.015 85)', accent: 'oklch(38% 0.13 264)', accentFg: 'oklch(98% 0.01 85)', mark: 'oklch(38% 0.13 264)' },

      light: { bg: '#fbf4eb', surface: '#f3e9df', fg: '#231814', muted: '#6a5952', line: '#ddd2c6', accent: '#a73b15', accentFg: '#fdf7f1', mark: '#a73b15' },
      dark: { bg: '#140e0b', surface: '#1f1613', fg: '#f1eae1', muted: '#b2a59c', line: '#3a2d29', accent: '#ef8d67', accentFg: '#140e0b', mark: '#ef8d67' },

    hex: {
      light: { bg: '#faf6ee', surface: '#f1ece3', fg: '#141822', muted: '#555b66', line: '#d9d4c9', accent: '#1d3c86', accentFg: '#fbf8f1', mark: '#1d3c86' },
      dark: { bg: '#0c0f16', surface: '#141821', fg: '#efebe2', muted: '#a0a5ae', line: '#2b303b', accent: '#97b7f8', accentFg: '#0c0f16', mark: '#97b7f8' },
    },
    contrast: { light: 'Texto 16.5 · Secundario 6.4 · Acento 9.6', dark: 'Texto 16.0 · Secundario 7.7 · Acento 9.5' },
  },
  {
    id: 'burdeos',
    name: '2 · Burdeos',
    note: 'Rojo vino profundo sobre un blanco roto frío. Serio y elegante: rojo, pero sin nada de naranja ni de arena.',

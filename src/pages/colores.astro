    light: { bg: 'oklch(97.5% 0.008 85)', surface: 'oklch(94.5% 0.01 85)', fg: 'oklch(21% 0.02 265)', muted: 'oklch(47% 0.02 265)', line: 'oklch(87% 0.012 85)', accent: 'oklch(30% 0.08 264)', accentFg: 'oklch(98% 0.008 85)', mark: 'oklch(54% 0.2 28)' },
    dark: { bg: 'oklch(17% 0.015 265)', surface: 'oklch(21% 0.018 265)', fg: 'oklch(94% 0.01 85)', muted: 'oklch(72% 0.015 265)', line: 'oklch(31% 0.02 265)', accent: 'oklch(90% 0.03 264)', accentFg: 'oklch(17% 0.015 265)', mark: 'oklch(66% 0.19 26)' },
    hex: {
      light: { bg: '#f9f6f1', surface: '#f0ece5', fg: '#141822', muted: '#555b66', line: '#d8d4cc', accent: '#192b55', accentFg: '#fbf8f2', mark: '#c92420' },
      dark: { bg: '#0c0f16', surface: '#141821', fg: '#eeebe4', muted: '#a0a5ae', line: '#2b303b', accent: '#d4def3', accentFg: '#0c0f16', mark: '#f05751' },

    dark: { bg: 'oklch(16% 0.008 270)', surface: 'oklch(20.5% 0.01 270)', fg: 'oklch(94% 0.006 250)', muted: 'oklch(72% 0.012 270)', line: 'oklch(30% 0.012 270)', accent: 'oklch(68% 0.12 20)', accentFg: 'oklch(14% 0.008 270)', mark: 'oklch(68% 0.12 20)' },
    hex: {
      light: { bg: '#f6f9fb', surface: '#edf0f4', fg: '#14161c', muted: '#585b63', line: '#d7dbdf', accent: '#7b2432', accentFg: '#f8fafd', mark: '#7b2432' },
      dark: { bg: '#0c0d11', surface: '#15171c', fg: '#e8ebef', muted: '#a1a4ac', line: '#2b2e34', accent: '#d87879', accentFg: '#08090c', mark: '#d87879' },
    },
    contrast: { light: 'Texto 17.1 · Secundario 6.5 · Acento 9.3', dark: 'Texto 16.3 · Secundario 7.8 · Acento 6.4' },
  },
  {
    id: 'bermellon',
    name: '3 · Tinta + bermellón',

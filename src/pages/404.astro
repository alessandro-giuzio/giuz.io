---
import Base from '@/layouts/Base.astro';

// Debris for the hold-to-blast. A seeded generator keeps it random-looking but
// identical on every build.
let seed = 404;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const between = (min: number, max: number) => min + rand() * (max - min);

// A jagged 3–5 corner polygon around the glyph's centre, so each piece looks snapped off.
const shardClip = () => {
  const corners = 3 + Math.floor(rand() * 3);
  const points = Array.from({ length: corners }, (_, i) => {
    const angle = (i / corners) * Math.PI * 2 + between(-0.4, 0.4);
    const radius = between(45, 80);
    const x = 50 + Math.cos(angle) * radius;
    const y = 50 + Math.sin(angle) * radius;
    return `${x.toFixed(0)}% ${y.toFixed(0)}%`;
  });
  return `polygon(${points.join(', ')})`;
};

const debris = [
  // One "4" survives almost whole, so the wreck still reads as the number.
  {
    ch: '4',
    x: -0.9,
    y: -0.35,
    z: 0.45,
    r: -28,
    s: 0.55,
    clip: 'polygon(0 0, 100% 0, 100% 62%, 74% 100%, 0 88%)',
    accent: false,
  },
  ...Array.from({ length: 20 }, () => ({
    ch: String(Math.floor(rand() * 10)),
    x: between(-1.8, 1.8),
    // Mostly above the centre, so the debris doesn't cover the heading below.
    y: between(-0.9, 0.3),
    z: between(-0.9, 0.9),
    r: between(-180, 180),
    s: between(0.12, 0.42),
    clip: shardClip(),
    accent: rand() < 0.3,
  })),
].map((p) => ({
  ...p,
  style: [
    `--x: ${p.x.toFixed(2)}`,
    `--y: ${p.y.toFixed(2)}`,
    `--z: ${p.z.toFixed(2)}`,
    `--r: ${p.r.toFixed(0)}deg`,
    `--s: ${p.s.toFixed(2)}`,
    `--clip: ${p.clip}`,
    `--d: ${between(0, 0.15).toFixed(2)}s`,
    `--b: ${between(3, 6).toFixed(1)}s`,
  ].join('; '),
}));
---

<Base title='Página no encontrada' noindex>
  <svg
    class='lines'
    viewBox='0 0 1440 900'
    preserveAspectRatio='xMidYMid slice'
    aria-hidden='true'
    focusable='false'>
    <path d='M-100 820 C 300 380, 900 260, 1540 420'></path>
    <path d='M-100 160 C 420 520, 1000 600, 1540 300'></path>
    <path d='M300 -60 C 380 360, 700 760, 1240 960'></path>
    <path class='lines-accent' d='M1500 80 C 1040 220, 620 560, -60 640'></path>
  </svg>

  <div
    class='relative z-1 mx-auto flex max-w-(--container-prose) flex-col items-center py-8 text-center sm:py-16'>
    <p class='digits font-heading' aria-hidden='true'>
      <span class='spin'>
        <span class='digit' data-d='4'>4</span><em class='digit' data-d='0'
          >0</em
        ><span class='digit' data-d='4'>4</span>
        <span class='debris'>
          {
            debris.map((p) => (
              <span
                class:list={['piece', { 'text-accent': p.accent }]}
                style={p.style}>
                <span class='shard'>{p.ch}</span>
              </span>
            ))
          }
        </span>
      </span>
    </p>

    <div class='content mt-8 space-y-4'>
      <h1 class='text-heading-2'>Esta página no existe.</h1>
      <p class='text-muted'>
        Puede que la haya movido o que nunca haya existido.
      </p>
    </div>

    <ul
      class='content mt-10 flex flex-wrap justify-center gap-x-8 gap-y-4 font-mono text-step--1 uppercase'>
      <li>
        <a href='/' class='link'
          >Volver al inicio <span aria-hidden='true'>→</span></a
        >
      </li>
    </ul>

    <!-- Hold-to-blast toy, CSS only via :active. The empty ontouchstart makes iOS Safari apply :active on touch. -->
    <button
      type='button'
      class='blast content mt-20 font-mono text-step--1 uppercase text-muted'
      ontouchstart=''>
      Mantén pulsado para romperla <span aria-hidden='true'>💥</span>
    </button>
  </div>
</Base>

<style>
  /* Decorative curves behind the page, a nod to trionn.com/404 without the WebGL. */
  .lines {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    fill: none;
    stroke: var(--line);
    stroke-width: 1.25;
  }

  .lines-accent {
    stroke: var(--accent);
    opacity: 0.35;
  }

  .digits {
    font-size: clamp(7rem, 28vw, 16rem);
    line-height: 1;
    perspective: 800px;
    /* Soft accent glow behind the numeral, like light spilling off it. */
    filter: drop-shadow(
      0 0 2.5rem color-mix(in oklch, var(--accent) 22%, transparent)
    );
  }

  .digit {
    position: relative;
    display: inline-block;
    --rim: var(--accent);
    /* Solid extrusion: each layer is the digit's colour sinking into the background,
       so it reads as a 3D block rather than a drop shadow. */
    text-shadow:
      1px 1px 0 color-mix(in oklch, currentColor 70%, var(--bg)),
      2px 2px 0 color-mix(in oklch, currentColor 60%, var(--bg)),
      3px 3px 0 color-mix(in oklch, currentColor 52%, var(--bg)),
      4px 4px 0 color-mix(in oklch, currentColor 45%, var(--bg)),
      5px 5px 0 color-mix(in oklch, currentColor 38%, var(--bg)),
      6px 6px 0 color-mix(in oklch, currentColor 32%, var(--bg)),
      7px 7px 0 color-mix(in oklch, currentColor 26%, var(--bg)),
      8px 8px 0 color-mix(in oklch, currentColor 20%, var(--bg)),
      12px 16px 28px color-mix(in oklch, var(--bg) 70%, transparent);

    /* Rim light: a copy of the glyph on top, filled with a moving band of accent light. */
    &::after {
      content: attr(data-d);
      position: absolute;
      inset: 0;
      color: transparent;
      text-shadow: none;
      background: linear-gradient(
          115deg,
          transparent 38%,
          color-mix(in oklch, var(--rim) 85%, transparent) 50%,
          transparent 62%
        )
        no-repeat;
      background-size: 300% 100%;
      background-position: 30% 0;
      -webkit-background-clip: text;
      background-clip: text;
      pointer-events: none;
    }
  }

  .digits em {
    font-style: italic;
    color: var(--accent);
    /* Accent light would vanish on the accent "0": light it with the palest token instead. */
    --rim: light-dark(var(--bg), var(--fg));
  }

  /* Holds the digits and the debris, so both turn together. */
  .spin {
    position: relative;
    display: inline-block;
    transform-style: preserve-3d;
    transform: rotateX(8deg) rotateY(-12deg);
  }

  .debris {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  /* Each piece starts hidden at the centre; --x/--y/--z are in em of the numeral. */
  .piece {
    position: absolute;
    top: 50%;
    left: 50%;
    opacity: 0;
    transform-style: preserve-3d;
  }

  .shard {
    display: block;
    font-size: calc(var(--s) * 1em);
    line-height: 1;
    translate: -50% -50%;
    clip-path: var(--clip);
    text-shadow:
      1px 1px 0 color-mix(in oklch, currentColor 60%, var(--bg)),
      2px 2px 0 color-mix(in oklch, currentColor 40%, var(--bg));
  }

  .link {
    display: inline-flex;
    gap: 2.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.2s;

    &:hover {
      border-color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lines path {
      stroke-dasharray: 2400;
      animation:
        draw 2.4s cubic-bezier(0.65, 0, 0.35, 1) backwards,
        drift 20s ease-in-out 2.4s infinite alternate;
    }

    .lines path:nth-child(2) {
      animation-delay: 0.2s, 2.6s;
    }

    .lines path:nth-child(3) {
      animation-delay: 0.4s, 2.8s;
    }

    .lines path:nth-child(4) {
      animation-delay: 0.6s, 3s;
    }

    .digits {
      animation: float 7s ease-in-out infinite alternate;
    }

    .spin {
      animation: spin 24s linear infinite;
    }

    .digit {
      animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) backwards;

      &::after {
        animation: rim 6s ease-in-out 1s infinite;
      }
    }

    .digit:nth-child(2) {
      animation-delay: 0.08s;

      &::after {
        animation-delay: 1.25s;
      }
    }

    .digit:nth-child(3) {
      animation-delay: 0.16s;

      &::after {
        animation-delay: 1.5s;
      }
    }

    .content {
      animation: fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.5s backwards;
    }

    ul.content {
      animation-delay: 0.65s;
    }

    .blast.content {
      animation-delay: 0.8s;
    }

    /* Hold to blast: the page shakes harder while held, then the digits burst after 1.5 s.
       Releasing drops :active, so everything snaps back and the digits rise in again. */
    .blast {
      position: relative;
      display: inline-block;
      padding-bottom: 0.35rem;
      cursor: pointer;
      user-select: none;
      -webkit-touch-callout: none;
      touch-action: manipulation;

      &::after {
        content: '';
        position: absolute;
        inset: auto 0 0;
        height: 1px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
      }

      &:active::after {
        transform: scaleX(1);
        transition: transform 1.5s linear;
      }
    }

    :global(html:has(.blast:active)) {
      overflow-x: clip;
    }

    /* Earthquake: translate and rotate run on separate properties with periods that don't
       line up, so the combined motion never settles into an obvious rhythm. It dies out
       just after the blast, leaving the debris floating in calm. */
    :global(body:has(.blast:active)) {
      animation:
        quake-build 1.5s linear,
        quake 0.41s linear 1.5s 2,
        tilt-soft 0.31s linear 0.6s 3,
        tilt 0.23s linear 1.5s 4;
    }

    :global(body:has(.blast:active)) .lines {
      animation: quake 0.37s linear 0.4s 6 reverse;
    }

    /* Debris flies out from the centre as the digits burst, then floats and turns with
       the numeral for as long as the button is held. */
    :global(body:has(.blast:active)) .piece {
      animation:
        scatter 1s cubic-bezier(0.2, 0.7, 0.3, 1) calc(1.5s + var(--d)) forwards,
        bob var(--b) ease-in-out calc(2.5s + var(--d)) infinite alternate;
    }

    :global(body:has(.blast:active)) .digit {
      animation: burst-left 0.9s cubic-bezier(0.2, 0.7, 0.3, 1) 1.5s forwards;
    }

    :global(body:has(.blast:active)) .digit:nth-child(2) {
      animation-name: burst-up;
    }

    :global(body:has(.blast:active)) .digit:nth-child(3) {
      animation-name: burst-right;
    }
  }

  /* Without motion there is no blast, so the button would do nothing: hide it. */
  @media (prefers-reduced-motion: reduce) {
    .blast {
      display: none;
    }
  }

  @keyframes quake-build {
    5% {
      translate: 1px 0;
    }
    11% {
      translate: -1px 1px;
    }
    16% {
      translate: 0 -1px;
    }
    23% {
      translate: 2px 1px;
    }
    28% {
      translate: -1px -2px;
    }
    34% {
      translate: -2px 1px;
    }
    41% {
      translate: 3px -1px;
    }
    47% {
      translate: 1px 3px;
    }
    52% {
      translate: -3px -2px;
    }
    58% {
      translate: 4px 1px;
    }
    64% {
      translate: -2px 4px;
    }
    69% {
      translate: -5px -3px;
    }
    75% {
      translate: 5px -4px;
    }
    81% {
      translate: 2px 6px;
    }
    86% {
      translate: -7px 2px;
    }
    92% {
      translate: 6px -6px;
    }
    97% {
      translate: -4px 7px;
    }
  }

  @keyframes quake {
    0% {
      translate: 0 0;
    }
    9% {
      translate: -9px 4px;
    }
    18% {
      translate: 7px -11px;
    }
    27% {
      translate: 12px 6px;
    }
    36% {
      translate: -5px 10px;
    }
    45% {
      translate: -12px -7px;
    }
    54% {
      translate: 4px -3px;
    }
    63% {
      translate: 10px 12px;
    }
    72% {
      translate: -8px -12px;
    }
    81% {
      translate: 6px 9px;
    }
    90% {
      translate: -11px 2px;
    }
    100% {
      translate: 0 0;
    }
  }

  @keyframes tilt-soft {
    25% {
      rotate: 0.3deg;
    }
    75% {
      rotate: -0.25deg;
    }
  }

  @keyframes tilt {
    0% {
      rotate: 0deg;
    }
    20% {
      rotate: -0.8deg;
    }
    45% {
      rotate: 0.6deg;
    }
    70% {
      rotate: -0.4deg;
    }
    85% {
      rotate: 0.9deg;
    }
    100% {
      rotate: 0deg;
    }
  }

  @keyframes burst-left {
    to {
      opacity: 0;
      filter: blur(6px);
      translate: -60vw -35vh;
      rotate: -140deg;
      scale: 1.8;
    }
  }

  @keyframes burst-up {
    to {
      opacity: 0;
      filter: blur(6px);
      translate: 8vw -80vh;
      rotate: 220deg;
      scale: 2.2;
    }
  }

  @keyframes burst-right {
    to {
      opacity: 0;
      filter: blur(6px);
      translate: 55vw 40vh;
      rotate: 160deg;
      scale: 1.6;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 2400;
    }
  }

  @keyframes drift {
    to {
      transform: translate(-24px, 16px) rotate(1deg);
    }
  }

  /* Slow full turn around the vertical axis, tipped slightly towards the viewer for depth. */
  @keyframes spin {
    from {
      transform: rotateX(8deg) rotateY(0deg);
    }
    to {
      transform: rotateX(8deg) rotateY(360deg);
    }
  }

  @keyframes scatter {
    from {
      opacity: 0;
      translate: 0 0 0;
      rotate: 0deg;
      scale: 0.2;
    }
    to {
      opacity: 1;
      translate: calc(var(--x) * 1em) calc(var(--y) * 1em) calc(var(--z) * 1em);
      rotate: var(--r);
      scale: 1;
    }
  }

  @keyframes bob {
    from {
      transform: translateY(-0.03em) rotate(-6deg);
    }
    to {
      transform: translateY(0.03em) rotate(6deg);
    }
  }

  @keyframes float {
    from {
      translate: 0 -0.5rem;
    }
    to {
      translate: 0 0.75rem;
    }
  }

  /* The light band sweeps left to right across the glyph, then rests off it. */
  @keyframes rim {
    0% {
      background-position: 100% 0;
    }
    60%,
    100% {
      background-position: 0% 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.35em) rotateX(-60deg);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>

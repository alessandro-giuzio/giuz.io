---
import Base from '@/layouts/Base.astro';
import Pending from '@/components/Pending.astro';
import { site } from '@/site.config';
---

<Base>
  <section class="max-w-(--container-prose) space-y-6">
    <p class="font-mono text-step--1 text-muted">{site.jobTitle} · {site.location.city}</p>
    <h1 class="text-heading-1">{site.tagline}</h1>
    <p class="text-step-1 text-muted">
      Soy {site.name}. Ayudo a agencias, estudios y diseñadores a convertir sus diseños en sitios rápidos, accesibles y
      fáciles de mantener.
    </p>
    <div class="flex flex-wrap gap-4 pt-2">
      <a href="/agencias/" class="rounded-md bg-accent px-5 py-3 font-medium text-accent-fg no-underline hover:opacity-90">
        Cómo trabajo con agencias
      </a>
      <a href="/contacto/" class="rounded-md border border-line px-5 py-3 font-medium no-underline hover:border-fg">
        Hablemos
      </a>
    </div>
  </section>

  <section class="mt-20 max-w-(--container-prose) space-y-4" aria-labelledby="oferta">
    <h2 id="oferta" class="text-heading-2">Por dónde empezar</h2>
    <Pending what="la Revisión técnica como oferta de entrada (qué incluye, precio, plazo)." />
  </section>

  <section class="mt-16 max-w-(--container-prose) space-y-4" aria-labelledby="proyectos">
    <h2 id="proyectos" class="text-heading-2">Proyectos recientes</h2>
    <Pending what="dos casos destacados con resultados medibles." />
  </section>
</Base>

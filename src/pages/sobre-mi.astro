---
import Base from '@/layouts/Base.astro';
import Pending from '@/components/Pending.astro';
import { site } from '@/site.config';
---

<Base title="Sobre mí" description={`Quién es ${site.name}, cómo trabaja y qué esperar al colaborar con él.`} ogType="profile">
  <div class="max-w-(--container-prose) space-y-12">
    <header class="space-y-4">
      <h1 class="text-heading-1">Sobre mí</h1>
      <Pending what="foto, trayectoria y cómo trabajo. Idiomas: español, inglés e italiano." />
    </header>

    <section class="space-y-4" aria-labelledby="faq">
      <h2 id="faq" class="text-heading-2">Preguntas que las agencias suelen hacerse</h2>
      <Pending what="¿trabajas solo?, ¿y si te pones enfermo?, ¿puedes ser invisible para nuestro cliente?, ¿qué pasa si dejamos de trabajar juntos?" />
    </section>
  </div>
</Base>

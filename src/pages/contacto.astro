---
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
---

<Base title="Contacto" description={`Escribe a ${site.name} o reserva una llamada de 20 minutos.`}>
  <div class="max-w-(--container-prose) space-y-6">
    <h1 class="text-heading-1">Hablemos</h1>
    <p class="text-step-1 text-muted">Cuéntame en qué estáis trabajando y vemos si encajamos.</p>
    <p>
      Email: <a href={`mailto:${site.email}`} class="text-accent underline">{site.email}</a>
    </p>
    {
      site.bookingUrl ? (
        <p>
          <a href={site.bookingUrl} class="text-accent underline">
            Reservar una llamada de 20 minutos
          </a>
        </p>
      ) : (
        <p class="pending">Contenido pendiente: enlace de reserva (site.config.ts → bookingUrl).</p>
      )
    }
  </div>
</Base>
